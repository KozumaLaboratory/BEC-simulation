#!/usr/bin/env bash
# Pre-commit hook: gitleaks + JuliaFormatter.
#
# Activate once per clone:
#   git config core.hooksPath .githooks
#
# Bypass selectively:
#   SKIP=gitleaks git commit ...     # skip secret scan
#   SKIP=format   git commit ...     # skip formatter
#   SKIP=all      git commit ...     # skip both
#
# Designed for the global `core.hooksPath=~/.config/git/hooks` setup that
# only runs gitleaks: this hook supersedes it for this repo and adds the
# JuliaFormatter check that mirrors .github/workflows/ci.yml.

set -euo pipefail

SKIP_GITLEAKS=0
SKIP_FORMAT=0
case "${SKIP:-}" in
    gitleaks) SKIP_GITLEAKS=1 ;;
    format)   SKIP_FORMAT=1 ;;
    all)      SKIP_GITLEAKS=1; SKIP_FORMAT=1 ;;
esac

# ── gitleaks: secret scan on staged content ──
if [ $SKIP_GITLEAKS -eq 0 ]; then
    if ! command -v gitleaks &>/dev/null; then
        echo "error: gitleaks not on PATH. Install or bypass: SKIP=gitleaks git commit ..."
        exit 1
    fi
    gitleaks protect --staged --redact --exit-code 1
fi

# ── JuliaFormatter: rewrite working tree on drift, abort commit, let
#    the author review and stage what they want. ──
#
# Why not auto-stage the formatter's edits:
#   1. Whole-file format folds unrelated drift in untouched lines into
#      the commit, polluting `git blame` granularity.
#   2. `git add <file>` after format silently clobbers the author's
#      unstaged hunks on the same file.
# Abort + warn is the safer default — the commit either lands
# formatter-clean (no drift) or doesn't land at all (drift detected,
# author reviews + stages intentionally).
if [ $SKIP_FORMAT -eq 0 ]; then
    staged_jl=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(src|test)/.*\.jl$' || true)
    if [ -n "$staged_jl" ]; then
        JULIA=""
        if command -v julia &>/dev/null; then
            JULIA=julia
        elif [ -x "$HOME/.juliaup/bin/julia" ]; then
            JULIA="$HOME/.juliaup/bin/julia"
        fi

        if [ -z "$JULIA" ]; then
            echo "warn: julia not found on PATH or in ~/.juliaup/bin/. Skipping format (CI will catch drift)."
        else
            # Format in place. Working tree is now formatter-clean, but
            # nothing has been staged yet.
            # shellcheck disable=SC2086
            $JULIA --startup-file=no -e 'using JuliaFormatter; format(ARGS)' $staged_jl

            # shellcheck disable=SC2086
            modified=$(git diff --name-only -- $staged_jl)
            if [ -n "$modified" ]; then
                echo
                echo "pre-commit: formatter rewrote the working tree (NOT staged):"
                echo "$modified" | sed 's/^/  /'
                echo
                echo "Review the diff, stage what you want, re-commit:"
                echo "  git diff       # see formatter edits"
                echo "  git add -p     # selectively stage"
                echo "  git add -u     # stage all of them"
                echo "Bypass with: SKIP=format git commit ..."
                exit 1
            fi
        fi
    fi
fi
