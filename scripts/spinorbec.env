# SpinorBEC autopilot environment — TSUBAME (UGE) backend wiring.
#
# Read by `SpinorBEC.default_autopilot_config` to auto-register a `:uge`
# backend so the dashboard's "tsubame (uge)" option and the
# spinor-autopilot.timer both reach TSUBAME without code edits.
#
# Loaded automatically by:
#   - systemd timer  : EnvironmentFile= in spinor-autopilot.service
#   - dashboard srv  : (set in your shell before launching, OR source
#                       this file from your rc — see below)
#
# Shell sourcing (interactive / dashboard dev):
#   set -a; source /home/suzume/workspace/BEC-simulation/scripts/spinorbec.env; set +a
#
# Format is systemd EnvironmentFile-compatible: KEY=VALUE only, no
# `export`, no shell expansion. Edit values inline.

# ── TSUBAME 4 (UGE) ──────────────────────────────────────────────────

# SSH alias from ~/.ssh/config (resolves to login.t4.gsic.titech.ac.jp).
SPINORBEC_TSUBAME_HOST=tsubame

# Repo checkout location on TSUBAME group storage. Must exist and be
# `Pkg.instantiate`d once before the first dispatch. Bootstrap:
#   ssh tsubame 'cd /gs/fs/tga-kozuma-kouhi/uk07267 && \
#     git clone <repo-url> BEC-simulation && \
#     cd BEC-simulation && \
#     /gs/fs/tga-kozuma-kouhi/shared/.juliaup/bin/julia --project=. -e "using Pkg; Pkg.instantiate()"'
SPINORBEC_TSUBAME_PROJECT_ROOT=/gs/fs/tga-kozuma-kouhi/uk07267/BEC-simulation

# Where remote run_dir's (runs/<cid>/) live. The autopilot `collect!`
# rsyncs results back into the local runs/ tree on completion, so the
# dashboard catalog reads only local files.
SPINORBEC_TSUBAME_RUNS_ROOT=/gs/fs/tga-kozuma-kouhi/uk07267/runs

# `qsub -g <group>` billing flag. NOT a UGE `-P` project — this is the
# TSUBAME-specific compute-group syntax tied to the lab's point balance.
SPINORBEC_TSUBAME_GROUP=tga-kozuma-kouhi

# Remote Julia binary. The lab's shared juliaup install keeps versions
# consistent across collaborators.
SPINORBEC_TSUBAME_JULIA=/gs/fs/tga-kozuma-kouhi/shared/.juliaup/bin/julia

# Julia depot for compute nodes. TSUBAME compute nodes do NOT inherit
# the login-node's depot setup, so without this they default to
# /home/<user>/.julia (an empty quota-restricted directory) and every
# job fails with "Package X is required but does not seem to be
# installed". Point at the lab's shared depot so the packages installed
# once by Pkg.add/instantiate are visible to every job.
SPINORBEC_TSUBAME_DEPOT=/gs/fs/tga-kozuma-kouhi/shared/.julia

# `module load <name>` inserted above the julia call in the submit
# script. TSUBAME 4 default is cuda/13.1.1; CUDA.jl typically lags so
# pin a known-compatible runtime. Alternatives discovered on T4:
#   cuda/11.8.0  cuda/12.0.0  cuda/12.1.0  cuda/12.3.2  cuda/12.8.0
SPINORBEC_TSUBAME_CUDA_MODULE=cuda/12.8.0

# When true, `stage_in` runs `git fetch && git checkout <entry.code_sha>
# && Pkg.instantiate` on the remote before each dispatch. Leave off
# until the first manual clone+instantiate succeeds; flip on for
# reproducibility once the remote checkout is healthy.
# SPINORBEC_TSUBAME_SYNC_CODE=true
