":"2026-04-15T20:36:31"}],"run_names":[],"run":"eu151_mz_scan","config_yaml":"# Eu151 Mz-constrained scan via YAML\n#\n# Sweeps target_magnetization from -6 → 0, computing the lowest-energy state\n# in each Mz sector. Uses N_atoms + omega_ref to compute c_total and c_dd\n# automatically from physical parameters.\n\npipeline:\n  - ground_state:\n      atom: Eu151\n      grid:\n        n: [64, 64, 64]\n        box: [20.0, 20.0, 20.0]\n      interactions:\n        N_atoms: 50000\n        omega_ref: 691.15        # 2π × 110 Hz\n        c1_ratio: 0.0\n        c_lhy: 1135.0            # Lima-Pelster ε_dd≈0.544\n      ddi:\n        enabled: true\n        # c_dd computed automatically from N_atoms + omega_ref\n      zeeman:\n        p: 0.0\n        q: 0.0\n      potential: {type: harmonic, omega: [1.0, 1.0, 1.1818]}   # 130/110\n      dt: 0.001\n      tol: 1.0e-7\n      initial_state: ferromagnetic_min\n      target_magnetization: -6.0\n      backend: cuda\n\nscan:\n  zip:\n    pipeline.0.target_magnetization: [-6.0, -5.5, -5.0, -4.5, -4.0, -3.5, -3.0, -2.5, -2.0, -1.5, -1.0, -0.5, 0.0]\n  continuation: true\n  auto_rotate_on_mz: true     # rotate prev_psi by Δα between Mz points\n","F":6,"n_points":13}